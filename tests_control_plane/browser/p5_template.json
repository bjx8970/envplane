{
  "schema_version": 1,
  "metadata": {"name": "P5 loopback lab"},
  "parameters": {
    "endpoint": {
      "type": "string",
      "label": "测试端点",
      "required": true,
      "selector": {
        "plugin_instance": "fixture",
        "action": "options",
        "value_field": "id",
        "label_field": "label"
      }
    },
    "note": {"type": "string", "label": "实验备注", "maxLength": 60, "required": true}
  },
  "quota": {"environments": 1, "vms": 0, "vcpu": 0, "memory_mb": 0},
  "create": {
    "steps": [{
      "id": "install", "plugin_instance": "fixture", "action": "install", "timeout_seconds": 12,
      "input": {"endpoint": {"$ref": "params.endpoint"}}
    }]
  },
  "resources": [{
    "key": "endpoint",
    "name": "Echo endpoint",
    "type_label": "SSH lab",
    "data": {"target": {"$ref": "steps.install.output.target"}},
    "display": {"note": {"$ref": "params.note"}},
    "actions": {
      "observe": {
        "label": "探测状态",
        "roles": ["student", "teacher", "admin"],
        "parameters": {},
        "steps": [{
          "id": "probe", "plugin_instance": "fixture", "action": "observe", "timeout_seconds": 8, "input": {}
        }],
        "state_mapping": {"value": {"$ref": "steps.probe.output.state"}, "ttl_seconds": 30}
      }
    }
  }],
  "actions": {
    "confirm": {
      "label": "触发待核对操作",
      "roles": ["student"],
      "parameters": {},
      "steps": [{
        "id": "confirm", "plugin_instance": "fixture", "action": "confirm", "timeout_seconds": 8, "input": {}
      }]
    }
  },
  "readiness": {
    "require_steps": ["install"],
    "require_resources": ["endpoint"],
    "credential_confirmation": {"step": "install", "credential": {"$ref": "steps.install.output.credential"}}
  },
  "cleanup": {
    "steps": [{"id": "retire", "plugin_instance": "fixture", "action": "retire", "timeout_seconds": 8, "input": {}}],
    "completion": {"require_steps": ["retire"]}
  },
  "access": {
    "shell": {
      "label": "实验终端",
      "roles": ["student"],
      "plugin_instance": "terminal",
      "session_type": "terminal",
      "target_ref": {"$ref": "environment.create_results.install.target"},
      "credential_ref": {"$ref": "environment.create_results.install.credential"},
      "input": {}
    }
  }
}
